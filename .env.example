# GEMINI_API_KEY: Optional Gemini AI API key if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EMPLOYER_ADMIN_PASSCODE: Optional server-side passcode to protect Employer Studio.
# Leave empty to use the built-in first-run employer workspace setup form.
EMPLOYER_ADMIN_PASSCODE=""
